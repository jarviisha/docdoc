# Copy to `.env` in this directory. Compose reads it when you run
# `docker compose -f packaging/docker/compose.yml up -d`; every variable here is
# optional, and compose.yml documents each one it forwards.

# Use a real model instead of the offline `echo` adapter. Set both lines, then
# run `up -d` again. Without a key, `gemini` reports unavailable and every
# extraction is refused.
# DOCDOC_MODEL_ADAPTERS=gemini
# GEMINI_API_KEY=

# The host port Postgres is published on. Change it if 5432 is already taken.
# DOCDOC_PG_PORT=55433
