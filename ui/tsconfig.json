{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,

    // One root since the viewer was removed (ADR-0020). The model/component
    // boundary inside it is a requirement (specs/011 FR-041, specs/008 FR-043)
    // rather than a folder convention, and `scripts/check-model-boundary.mjs`
    // is what enforces it -- TypeScript paths make a boundary expressible, not
    // enforced.
    // No `baseUrl`: TypeScript 7 removed it, and non-relative targets with it.
    "paths": {
      "@console/*": ["./src/console/*"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
